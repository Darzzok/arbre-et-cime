# ---------------------------------------------------------------------------
# Arbre et Cime Elagage — variables d'environnement (exemple)
# Copier ce fichier en `.env.local` et remplir les valeurs reelles.
# Ce fichier ne doit JAMAIS contenir de secret reel.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Origine publique COMPLETE du site : protocole + domaine, sans chemin.
#   Exemple valide   : https://example.com
#   Exemples refuses : example.com  |  https://example.com/accueil  |  (vide)
# Un eventuel slash final ou chemin est ignore automatiquement.
# Sert au metadataBase, au sitemap, aux URLs canoniques et au JSON-LD.
#
# En developpement, si la variable est absente, http://localhost:3000 est
# utilise. En production, si elle est absente ou invalide, metadataBase n'est
# pas emis (le build reussit, mais les URLs absolues sont perdues) :
# elle DOIT donc etre definie dans l'environnement de production (Vercel).
NEXT_PUBLIC_SITE_URL=

# --- Garde-fou d'indexation -------------------------------------------------
# Interrupteur global d'indexation par les moteurs de recherche.
#
# Le site est deploye publiquement AVANT d'avoir son contenu definitif : tant
# que les pages portent un contenu d'attente, elles ne doivent PAS entrer dans
# l'index, sous peine d'abimer durablement le domaine.
#
#   "true"  -> comportement SEO normal : index/follow, canonicals, sitemap
#   toute autre valeur (absente, vide, "false", "1", "TRUE")
#           -> noindex,follow sur les pages publiques, sitemap vide,
#              aucune canonical, aucun JSON-LD
#
# Le defaut est donc le comportement SUR. A passer a "true" UNE SEULE FOIS,
# au lancement definitif (phase 18 de ROADMAP.md), jamais avant.
NEXT_PUBLIC_SITE_INDEXABLE=false

# --- Coordonnees publiques (NAP — doivent etre identiques partout) ----------
#
# CES TROIS VALEURS SONT VOLONTAIREMENT VIDES ICI.
#
# Le telephone et l'e-mail sont CONFIRMES par le client et vivent dans
# `src/lib/site.ts`, la source de verite unique. Un site deploye ne doit pas
# perdre ses coordonnees parce qu'une variable manque sur l'hebergeur.
#
# Ces variables ne servent donc qu'a SURCHARGER ces valeurs — changer de numero
# ou d'adresse sans redeployer le code.
#
# Ne jamais y ecrire de valeur d'exemple. `site.ts` en deduit
# `contact.phoneConfirmed` : une valeur factice mais syntaxiquement valide
# suffirait a publier un faux numero dans une soixantaine d'emplacements du
# site — exactement ce que `CLAUDE.md` interdit.

# Telephone au format international pour les liens tel: — ex. +33612345678
NEXT_PUBLIC_PHONE=
# Telephone au format affiche — ex. 06 12 34 56 78
NEXT_PUBLIC_PHONE_DISPLAY=
# E-mail public.
NEXT_PUBLIC_EMAIL=

# --- Envoi des demandes de devis (phase 13) --------------------------------
# Adresse de reception des demandes de devis
QUOTE_INBOX_EMAIL=
# Cle du fournisseur d'envoi transactionnel (Resend, Brevo, ...) — SECRET
QUOTE_MAIL_API_KEY=
# Expediteur verifie aupres du fournisseur
QUOTE_MAIL_FROM=

# --- Stockage des photos de chantier jointes au devis (phase 12/13) --------
# Fournisseur de stockage objet (ex: Vercel Blob, S3, R2) — SECRET
STORAGE_TOKEN=

# --- Anti-spam formulaire (phase 12) ---------------------------------------
# Cles Cloudflare Turnstile / hCaptcha
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Analytics / conversions (phase 16) ------------------------------------
# Identifiant de mesure (Plausible, Umami, GA4...)
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Verification Search Console (phase 14) --------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
