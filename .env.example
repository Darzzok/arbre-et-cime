# ---------------------------------------------------------------------------
# Arbre et Cime Elagage — variables d'environnement (exemple)
# Copier ce fichier en `.env.local` et remplir les valeurs reelles.
# Ce fichier ne doit JAMAIS contenir de secret reel.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Origine publique COMPLETE du site : protocole + domaine, sans chemin.
#   Exemple valide   : https://example.com
#   Exemples refuses : example.com  |  https://example.com/accueil  |  (vide)
# Un eventuel slash final ou chemin est ignore automatiquement.
# Sert au metadataBase, au sitemap, aux URLs canoniques et au JSON-LD.
#
# En developpement, si la variable est absente, http://localhost:3000 est
# utilise. En production, si elle est absente ou invalide, metadataBase n'est
# pas emis (le build reussit, mais les URLs absolues sont perdues) :
# elle DOIT donc etre definie dans l'environnement de production (Vercel).
NEXT_PUBLIC_SITE_URL=

# --- Coordonnees publiques (NAP — doivent etre identiques partout) ----------
# Telephone au format international pour les liens tel:
NEXT_PUBLIC_PHONE=+33000000000
# Telephone au format affiche
NEXT_PUBLIC_PHONE_DISPLAY=00 00 00 00 00
NEXT_PUBLIC_EMAIL=contact@example.fr

# --- Envoi des demandes de devis (phase 13) --------------------------------
# Adresse de reception des demandes de devis
QUOTE_INBOX_EMAIL=
# Cle du fournisseur d'envoi transactionnel (Resend, Brevo, ...) — SECRET
QUOTE_MAIL_API_KEY=
# Expediteur verifie aupres du fournisseur
QUOTE_MAIL_FROM=

# --- Stockage des photos de chantier jointes au devis (phase 12/13) --------
# Fournisseur de stockage objet (ex: Vercel Blob, S3, R2) — SECRET
STORAGE_TOKEN=

# --- Anti-spam formulaire (phase 12) ---------------------------------------
# Cles Cloudflare Turnstile / hCaptcha
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Analytics / conversions (phase 16) ------------------------------------
# Identifiant de mesure (Plausible, Umami, GA4...)
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# --- Verification Search Console (phase 14) --------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
